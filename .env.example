# Copy to .env and fill in. Never commit the real values — in Kubernetes these are
# Secrets, not ConfigMaps.

# Alpaca credentials
APCA-API-KEY-ID=
APCA-API-SECRET-KEY=

# Alpaca endpoints (defaults shown; override for paper/sandbox hosts)
ALPACA-URL=https://data.alpaca.markets/v2
ALPACA-CORPORATE-ACTIONS-URL=https://data.alpaca.markets/v1/corporate-actions
ALPACA-TRADING-URL=https://api.alpaca.markets/v2

# Unity Catalog — the catalog every table is registered in
UNITY_CATALOG_URI=http://unitycatalog:8080
UNITY_CATALOG_NAME=lakehouse

# Where the external Delta tables are laid out, mounted by quant-infrastructure.
# Must resolve to the same storage for every engine that reads the catalog.
LAKEHOUSE_ROOT=/data/lake

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=
